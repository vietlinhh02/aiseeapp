	<string>AiSee cần camera khi trợ lý hoặc cuộc gọi dùng hình ảnh.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AiSee cần vị trí để trợ lý hướng dẫn bạn.</string>
	<key>CFBundleDisplayName</key>
	<string>aisee</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
